import numpy as np
def decision_trades(current_data, cash, holdings):
    """
    Trading strategy based on the trend of stock prices.
    Args:
        current_data (pd.DataFrame): Stock data available up to the current date.
        cash (float): Current cash available.
        holdings (dict): Current stock holdings.
    Returns:
        dict: Trading decisions in the format {stock: (action, quantity)}.
    """
    decisions = {}
    for stock in holdings:
        prices = current_data[stock].values
        if len(prices) < 2:
            continue  # Not enough data to determine trend
        trend = np.polyfit(range(len(prices)), prices, 1)[0]  # Linear trend
        current_price = prices[-1]
        if trend > 0:  # Upward trend
            action = "buy"
            quantity = min(1, cash / current_price)  # Buy up to 1 share
        else:  # Downward trend
            action = "sell"
            quantity = min(holdings[stock], 1)  # Sell up to 1 share
        decisions[stock] = (action, quantity)
    return decisions
